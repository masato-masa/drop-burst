{
  "name": "drop-burst",
  "version": "0.1.0",
  "description": "しずくバースト — しずくを足して泡をはじけさせ、連鎖で全部消すパズル",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 5260 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types scripts/audit.ts",
    "levels": "node --experimental-strip-types scripts/gen-levels.ts",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
